# Скопируйте в .env и поправьте. Все строки необязательны.

# Порт, на котором сайт доступен снаружи (студенты — /, руководство — /rukovodstvo)
HTTP_PORT=80
# Публичный адрес сайта (для ссылок в календаре и в сообщениях), например https://raspisanie.vavilovsar.ru
PUBLIC_URL=
SITE_TITLE=Расписание занятий — Вавиловский университет
STAFF_BASE_PATH=rukovodstvo

# Часовой пояс и время сбора с сайта вуза
TZ_NAME=Europe/Saratov
COLLECT_TIMES=03:00,13:00

# Семестры: «MM-DD» — каждый год, «YYYY-MM-DD» — один раз. Неделя начала семестра — верхняя.
AUTUMN_START=09-01
AUTUMN_END=12-31
# Весну задайте перед её началом, например SPRING_START=2027-02-09
SPRING_START=
SPRING_END=06-30

# Сбор, где занятий меньше этой доли от прошлого, не публикуется (сайт вуза отдал не всё)
PUBLISH_MIN_RATIO=0.7
# Если в форме обучения изменилось больше этой доли занятий — «новое расписание» одной строкой
MAJOR_CHANGE_RATIO=0.3
# Сколько дней показывать пометку «изменено» у занятия
CHANGE_BADGE_DAYS=7
# Сколько сообщений об ошибках в час можно отправить с одного адреса
REPORTS_PER_HOUR=5

# Резервные копии (data/backups, раз в сутки): сколько последних архивов хранить
BACKUP_KEEP_DAYS=14
