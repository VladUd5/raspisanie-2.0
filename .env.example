# Скопируйте в .env. Все параметры необязательны.

# Внешний порт (/ — студенты, /rukovodstvo — руководство) и публичный адрес (ссылки на календарь)
HTTP_PORT=80
PUBLIC_URL=
SITE_TITLE=Расписание занятий — Вавиловский университет
STAFF_BASE_PATH=rukovodstvo

# Часовой пояс и сбор расписания: дни (пн,вт,ср,чт,пт,сб,вс или «каждый») и время
TZ_NAME=Europe/Saratov
COLLECT_DAYS=пн,чт
COLLECT_TIMES=03:00

# Даты семестров. По умолчанию берутся из графиков учебного процесса; заданные здесь главнее.
# Формат «MM-DD» — каждый год, «YYYY-MM-DD» — один раз. Пример: SPRING_START=2027-02-01
AUTUMN_START=
AUTUMN_END=
SPRING_START=
SPRING_END=

# Правка производственного календаря, даты через запятую:
# HOLIDAYS_EXTRA — дополнительные выходные, WORKDAYS_EXTRA — учебные дни вместо праздников
HOLIDAYS_EXTRA=
WORKDAYS_EXTRA=

# Минимальная доля занятий от прошлой версии, при которой сбор публикуется
PUBLISH_MIN_RATIO=0.7
# Доля изменённых занятий формы обучения, при которой изменения показываются одной строкой
MAJOR_CHANGE_RATIO=0.3
# Сколько дней держится пометка «изменено»
CHANGE_BADGE_DAYS=7
# Лимит сообщений об ошибках в час с одного адреса
REPORTS_PER_HOUR=5

# Сколько ежедневных резервных копий хранить
BACKUP_KEEP_DAYS=14
