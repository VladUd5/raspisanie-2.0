# Скопируйте в .env и поправьте. Все строки необязательны.

# Порт, на котором сайт доступен снаружи (студенты — /, руководство — /rukovodstvo)
HTTP_PORT=80
# Публичный адрес сайта (для ссылок в календаре и в сообщениях), например https://raspisanie.vavilovsar.ru
PUBLIC_URL=
SITE_TITLE=Расписание занятий — Вавиловский университет
STAFF_BASE_PATH=rukovodstvo

# Часовой пояс и сбор расписания с сайта вуза: дни (пн,вт,ср,чт,пт,сб,вс или «каждый») и время.
# Внеочередной сбор — кнопка «Проверить сайт сейчас» в версии для руководства.
TZ_NAME=Europe/Saratov
COLLECT_DAYS=пн,чт
COLLECT_TIMES=03:00

# Семестры задавать не нужно: они берутся из графиков учебного процесса на сайте вуза.
# Заданные здесь даты главнее графиков («MM-DD» — каждый год, «YYYY-MM-DD» — один раз);
# такой семестр начинается с верхней недели. Например: SPRING_START=2027-02-01
AUTUMN_START=
AUTUMN_END=
SPRING_START=
SPRING_END=

# Праздники — производственный календарь РФ и дни «=» в графиках вуза. Поправить вручную
# (даты через запятую): лишний выходной — HOLIDAYS_EXTRA, учебный день вместо праздника — WORKDAYS_EXTRA
HOLIDAYS_EXTRA=
WORKDAYS_EXTRA=

# Сбор, где занятий меньше этой доли от прошлого, не публикуется (сайт вуза отдал не всё)
PUBLISH_MIN_RATIO=0.7
# Если в форме обучения изменилось больше этой доли занятий — «новое расписание» одной строкой
MAJOR_CHANGE_RATIO=0.3
# Сколько дней показывать пометку «изменено» у занятия
CHANGE_BADGE_DAYS=7
# Сколько сообщений об ошибках в час можно отправить с одного адреса
REPORTS_PER_HOUR=5

# Резервные копии (data/backups, раз в сутки): сколько последних архивов хранить
BACKUP_KEEP_DAYS=14
